{
	"name": "monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format": "prettier --write .",
		"lint": "turbo run lint && prettier --check .",
		"prepare": "husky",
		"typecheck": "turbo run typecheck"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@commitlint/types": "^21.2.3",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"eslint": "catalog:",
		"husky": "^9.1.7",
		"jiti": "catalog:",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-packagejson": "^3.1.0",
		"turbo": "^2.11.10"
	},
	"packageManager": "pnpm@12.18.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.18.0",
			"onFail": "download"
		}
	}
}
