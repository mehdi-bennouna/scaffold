{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"transit": {
			"dependsOn": ["^transit"]
		},
		"build": {
			"dependsOn": ["^build", "transit"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["transit"]
		},
		"lint": {
			"dependsOn": ["transit"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
